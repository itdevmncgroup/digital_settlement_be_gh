NODE_ENV=development
PORT=3000

# PostgreSQL (Cloud) - BRD section 27. DB_PROVIDER picks which
# DATABASE_URL_<PROVIDER> below gets copied into DATABASE_URL at process start
# (src/config/resolve-database-url.ts for the app, scripts/resolve-database-url.js
# for prisma:*/seed npm scripts) - all three are plain PostgreSQL underneath
# (same Prisma "postgresql" provider, different host), so only the connection
# string changes:
#   postgres (default) -> DATABASE_URL_POSTGRES (self-hosted/local PostgreSQL)
#   supabase            -> DATABASE_URL_SUPABASE (Supabase - use the pooled/PgBouncer
#                          connection string from Project Settings > Database for the
#                          app, since Prisma opens many short-lived connections)
#   aws                 -> DATABASE_URL_AWS (AWS RDS/Aurora PostgreSQL)
DB_PROVIDER=postgres
DATABASE_URL_POSTGRES="postgresql://postgres:postgres@localhost:5432/sce_expense?schema=public"
DATABASE_URL_SUPABASE=
DATABASE_URL_AWS=

# Effective connection string Prisma actually reads (prisma/schema.prisma).
# Left here as the fallback if DATABASE_URL_<PROVIDER> above is unset for the
# selected DB_PROVIDER - normally you don't need to touch this directly.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sce_expense?schema=public"

# JWT (BRD section 34)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Object storage (BRD section 30, src/common/storage/). STORAGE_PROVIDER picks
# the backend - only storageKey/size/checksum ever leave StorageService, so
# switching is safe for new uploads (existing rows keep pointing at whichever
# backend originally stored them; this repo does not migrate objects between
# backends on a switch):
#   local  (default) -> disk under STORAGE_DIR
#   s3                -> AWS S3 / S3-compatible (MinIO, ...), needs S3_* below
#   gdrive            -> Google Drive, needs GDRIVE_* below
STORAGE_PROVIDER=local
STORAGE_DIR=./storage

# S3 (STORAGE_PROVIDER=s3). Leave S3_ENDPOINT blank for real AWS S3; set it for
# an S3-compatible service (MinIO, ...) - path-style addressing is then used
# automatically. S3_ACCESS_KEY/S3_SECRET_KEY blank = SDK default credential
# chain (IAM role, shared config, ...).
S3_ENDPOINT=
S3_BUCKET=sce-invoices
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Google Drive (STORAGE_PROVIDER=gdrive). Service-account auth - set ONE of
# GDRIVE_SERVICE_ACCOUNT_JSON (inline JSON) or GDRIVE_SERVICE_ACCOUNT_PATH
# (path to the key file). GDRIVE_FOLDER_ID is optional - uploads go to Drive's
# root if unset. The service account must have edit access to that folder.
GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_SERVICE_ACCOUNT_PATH=
GDRIVE_FOLDER_ID=

# Max invoice upload size in bytes (BRD section 34 - file size limitation)
MAX_UPLOAD_SIZE_BYTES=10485760

# Rate limit (BRD section 34)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Approval-via-email (one-click links for Expense/Event, plain deep-link
# notice for Settlement - see src/approvals/approvals.service.ts notifyStep)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SCE Expense <noreply@sce-expense.local>"
API_PUBLIC_URL=http://localhost:3000/api/v1
APP_PUBLIC_URL=http://localhost:3001
APPROVAL_EMAIL_TOKEN_TTL_DAYS=7

# Push notifications (src/notifications/push.service.ts) - approval-activity
# alerts to the mobile app. Unset = push is silently disabled (in-app
# notifications and email still work). Set ONE of these to the Firebase
# project's service-account credentials:
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Receipt/statement OCR backend (src/common/ocr/). OCR_PROVIDER picks it:
#   tesseract (default) -> local tesseract.js, no external calls/credentials
#   textract             -> AWS Textract DetectDocumentText, needs AWS_* below
#   ai                   -> Claude vision transcription, needs OCR_AI_* below
OCR_PROVIDER=tesseract

# Tesseract trained-data tier (OCR_PROVIDER=tesseract, or unset). Unset =
# library default (integerized tessdata_best - already decent accuracy/speed
# balance).
#   fast = tessdata_fast (smallest/quickest, lowest accuracy)
#   best = tessdata_best (float, largest/slowest, highest accuracy)
OCR_TRAINED_DATA=

# AWS Textract (OCR_PROVIDER=textract). Standard AWS SDK credential env vars -
# separate from S3_ACCESS_KEY/S3_SECRET_KEY above since Textract may live
# under a different IAM principal than the storage bucket. Blank = SDK
# default credential chain (IAM role, shared config, ...).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# AI vision OCR (OCR_PROVIDER=ai). Uses the Claude API (Anthropic) to
# transcribe receipt/statement images. OCR_AI_API_KEY falls back to
# ANTHROPIC_API_KEY if unset; OCR_AI_MODEL defaults to claude-sonnet-5.
OCR_AI_API_KEY=
ANTHROPIC_API_KEY=
OCR_AI_MODEL=claude-sonnet-5

# External PR push (src/external-sync/external-sync.service.ts) - fires once a
# Settlement's final approval tier is submitted (ApprovalsService.settlementFullyComplete).
# Unset EXTERNAL_SETTLEMENT_API_URL = falls back to this app's own dummy stand-in
# (src/external-sync/external-sync.controller.ts, /api/v1/external/settlements) -
# point it elsewhere once the real external endpoint exists.
EXTERNAL_SETTLEMENT_API_URL=
EXTERNAL_API_KEY=e308a8bc-a99e-4cc0-ad7a-cc1c96e7d147
# org_id sent in the PR push payload - one value per Unit (RCTI/GTV/MNCTV/INews).
API_EXTERNAL_ORG_ID=RCTI
