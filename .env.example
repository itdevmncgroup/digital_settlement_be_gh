NODE_ENV=development
PORT=3000

# PostgreSQL (Cloud) - BRD section 27
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sce_expense?schema=public"

# JWT (BRD section 34)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Object storage (BRD section 30). Local disk for now; swap StorageService for
# an S3/MinIO client later without touching callers (only storageKey leaves it).
STORAGE_DIR=./storage
S3_ENDPOINT=
S3_BUCKET=sce-invoices
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Max invoice upload size in bytes (BRD section 34 - file size limitation)
MAX_UPLOAD_SIZE_BYTES=10485760

# Rate limit (BRD section 34)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Approval-via-email (one-click links for Expense/Event, plain deep-link
# notice for Settlement - see src/approvals/approvals.service.ts notifyStep)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SCE Expense <noreply@sce-expense.local>"
API_PUBLIC_URL=http://localhost:3000/api/v1
APP_PUBLIC_URL=http://localhost:3001
APPROVAL_EMAIL_TOKEN_TTL_DAYS=7

# Push notifications (src/notifications/push.service.ts) - approval-activity
# alerts to the mobile app. Unset = push is silently disabled (in-app
# notifications and email still work). Set ONE of these to the Firebase
# project's service-account credentials:
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
