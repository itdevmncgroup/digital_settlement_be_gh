// Sales Client Entertainment & Expense Management System
// Backend API Core - Prisma schema (BRD section 27-29)
// Scope: Auth/RBAC, Master Data, Event, Expense, Invoice (schema only, no OCR/LLM processing yet),
// Approval Workflow, Audit Trail. OCR/Matching/Import/Notification worker tables intentionally
// deferred to the AI-Worker phase (BRD out of scope for "Backend API Core").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / RBAC (BRD section 5, 27, 34)
// ---------------------------------------------------------------------------

// Not used by any column - kept only so `RoleName` still exists as a generated
// TS enum for the ~30 `@Roles(RoleName.X)` guard call sites across the API,
// which protect the app's built-in feature set and are NOT dynamic. Role.name
// itself (below) is a free-text column: Admin can create additional custom
// roles via the Role master page, but a custom role has no route guard wired
// to it, so it grants no extra access until a developer adds one.
enum RoleName {
  SALES
  ADMIN
  MANAGEMENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String           @id @default(uuid())
  employeeId   String           @unique
  name         String
  email        String           @unique
  phone        String?
  positionId   String?
  position     Position?        @relation(fields: [positionId], references: [id])
  departments  UserDepartment[]
  unitId       String?
  unit         Unit?            @relation(fields: [unitId], references: [id])
  status       UserStatus       @default(ACTIVE)
  profilePhoto String?
  passwordHash String

  roles UserRole[]

  salesAssignments        SalesAssignment[]              @relation("AssignmentSales")
  events                  Event[]                        @relation("EventSales")
  expenseRequests         ExpenseRequest[]               @relation("ExpenseRequestRequester")
  expenseRequestsCreated  ExpenseRequest[]               @relation("ExpenseRequestCreatedBy")
  expenseRequestsBudgeted ExpenseRequest[]               @relation("ExpenseRequestBudgetBy")
  expenseRequestsVerified ExpenseRequest[]               @relation("ExpenseRequestVerifiedBy")
  expenses                Expense[]                      @relation("ExpenseSales")
  expensesInputted        Expense[]                      @relation("ExpenseCreatedBy")
  invoicesModified        Invoice[]                      @relation("InvoiceModifiedBy")
  approvalActions         ApprovalAction[]               @relation("ApprovalActor")
  approvalRequestSteps    ApprovalRequestStep[]          @relation("ApprovalStepApprover")
  submittedApprovalSteps  ApprovalRequestStep[]          @relation("ApprovalStepSubmitter")
  departmentApproverOf    DepartmentPositionAssignment[] @relation("DepartmentPositionUser")
  auditLogs               AuditLog[]
  bankSettlementBatches   BankSettlementBatch[]          @relation("BatchUploadedBy")
  bankTransactionsMatched BankTransaction[]              @relation("BankTxnMatchedBy")
  settlementsCreated      Settlement[]                   @relation("SettlementCreatedBy")
  auditFindingsResolved   AuditFinding[]                 @relation("AuditFindingResolvedBy")
  notifications           Notification[]
  deviceTokens            DeviceToken[]
  creditCards             CreditCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  // Free text (not the RoleName enum) - lets Admin create custom roles beyond
  // the 5 built-in ones. See the RoleName enum's comment above for the caveat.
  name        String           @unique
  description String?
  isActive    Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  isActive    Boolean          @default(true)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Master Data (BRD section 16)
// ---------------------------------------------------------------------------

// Department = an org department AND/OR a named Sales coverage group (formerly
// the separate "Pod" concept - "POD 1".."POD 10" are Department rows just like
// "Sales & Marketing"). Coverage (which Agency<->Brand pairs it covers) is
// DepartmentAssignment; per-department approvers (e.g. "Head" for a specific
// Department) is DepartmentPositionAssignment. Membership - which Sales
// belongs to which Department(s), many-to-many - is UserDepartment.
model Department {
  id                    String                         @id @default(uuid())
  code                  String?                        @unique
  name                  String                         @unique
  isActive              Boolean                        @default(true)
  memberships           UserDepartment[]
  events                Event[]
  expenses              Expense[]
  expenseRequests       ExpenseRequest[]
  approvalLevels        ApprovalLevelDepartment[]
  settlements           Settlement[]
  assignments           DepartmentAssignment[]
  approvers             DepartmentPositionAssignment[]
  creditCards           CreditCard[]
  auditFindings         AuditFinding[]
  bankSettlementBatches BankSettlementBatch[]
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  @@map("departments")
}

model Position {
  id                  String                           @id @default(uuid())
  code                String                           @unique
  name                String
  isActive            Boolean                          @default(true)
  users               User[]
  levelSteps          ApprovalLevelStep[]
  departmentApprovers DepartmentPositionAssignment[]
  requestSteps        ApprovalRequestStep[]
  actionsAsPosition   ApprovalAction[]
  requestorForLevels  ApprovalLevelRequestorPosition[]
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  @@map("positions")
}

// Who holds a given Position for a specific Department - needed because e.g.
// "Head" differs per Department (Department 1's Head != Department 2's Head).
model DepartmentPositionAssignment {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  positionId   String
  position     Position   @relation(fields: [positionId], references: [id])
  userId       String
  user         User       @relation("DepartmentPositionUser", fields: [userId], references: [id])
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now())

  @@unique([departmentId, positionId])
  @@map("department_position_assignments")
}

// Which Department(s) a User belongs to - many-to-many, replacing the old
// single User.departmentId scalar FK (a Sales/Sales Admin can now cover more
// than one Department/Pod).
model UserDepartment {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now())

  @@unique([userId, departmentId])
  @@map("user_departments")
}

model Unit {
  id                    String                 @id @default(uuid())
  code                  String                 @unique
  name                  String
  isActive              Boolean                @default(true)
  // External system's org/unit code (e.g. RCTI=84, GTV=85, MNCTV=86, INews=83) -
  // sent as org_id's companion lookup / PR-line identifiers to the external PR
  // push (ExternalSyncService.pushSettlement). Not the same as `code` above.
  unitCode              String?                @map("unit_code")
  // Official/long company name (master "Full Name"); `name` stays the short label.
  fullName              String?                @map("full_name")
  // Logo image lives in object storage (StorageService) - only its key/type are stored here.
  logoStorageKey        String?                @map("logo_storage_key")
  logoMimeType          String?                @map("logo_mime_type")
  // Default Settlement allocation split for this Unit (e.g. RCTI 48 / MNCTV 43 /
  // GTV 14) - only a starting value, each SettlementAllocation row still stores
  // its own percentage and can override it.
  revenueSharePercent   Decimal?               @db.Decimal(5, 2)
  users                 User[]
  assignments           SalesAssignment[]
  events                Event[]
  expenses              Expense[]
  participants          ExpenseParticipant[]
  settlementAllocations SettlementAllocation[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@map("units")
}

// Agency -> Advertiser -> Brand is a strict ownership chain: an Agency represents
// many Advertisers, each Advertiser owns many Brands, and each Brand belongs to
// exactly one Advertiser (never shared). Agency and Advertiser are deliberately
// distinct entities - Agency is not the same thing as an Advertiser.
model Agency {
  id                     String                 @id @default(uuid())
  code                   String                 @unique
  name                   String
  isActive               Boolean                @default(true)
  advertisers            Advertiser[]
  departmentAssignments  DepartmentAssignment[]
  expenseAgencies        ExpenseAgency[]
  expenseRequestAgencies ExpenseRequestAgency[]
  participants           ExpenseParticipant[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@map("agencies")
}

model Advertiser {
  id                        String                     @id @default(uuid())
  code                      String                     @unique
  name                      String
  isActive                  Boolean                    @default(true)
  agencyId                  String
  agency                    Agency                     @relation(fields: [agencyId], references: [id])
  brands                    Brand[]
  events                    Event[]
  expenses                  Expense[]
  expenseAdvertisers        ExpenseAdvertiser[]
  expenseRequestAdvertisers ExpenseRequestAdvertiser[]
  participants              ExpenseParticipant[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@map("advertisers")
}

model Brand {
  id                    String                 @id @default(uuid())
  code                  String                 @unique
  name                  String
  isActive              Boolean                @default(true)
  advertiserId          String
  advertiser            Advertiser             @relation(fields: [advertiserId], references: [id])
  departmentAssignments DepartmentAssignment[]
  events                Event[]
  expenses              Expense[]
  expenseBrands         ExpenseBrand[]
  expenseRequestBrands  ExpenseRequestBrand[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@map("brands")
}

// Credit Card master data - Sales pick the company card used to pay for an
// Expense (BR: card is master-managed, not free text, so Finance can reconcile
// against the bank settlement PDF via AutoMatching).
// 1 Department = 1 credit card: a Sales in a given Department may only spend
// on that Department's own card. departmentId is unique so a card can't be
// assigned to more than one Department.
// 1 Department can hold many cards; 1 User (and thus 1 Position, via
// User.positionId) can likewise hold more than one card - no uniqueness on
// either FK.
model CreditCard {
  id                    String                @id @default(uuid())
  bank                  String
  last4                 String
  isActive              Boolean               @default(true)
  departmentId          String?
  department            Department?           @relation(fields: [departmentId], references: [id])
  userId                String?
  user                  User?                 @relation(fields: [userId], references: [id])
  expenses              Expense[]
  bankSettlementBatches BankSettlementBatch[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@map("credit_cards")
}

// One Agency <-> Brand pairing within a Department. A Department can cover
// multiple Brands under the same Agency (e.g. picking several Advertisers
// under an Agency, then several Brands under those) - uniqueness is per
// Brand, not per Agency, so the same Brand can't be added twice to one
// Department. The paired Brand's actual Advertiser/Agency ownership chain is
// validated against agencyId at the service layer (DepartmentsService) -
// schema can't express that cross-relation check.
model DepartmentAssignment {
  id            String     @id @default(uuid())
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  agencyId      String
  agency        Agency     @relation(fields: [agencyId], references: [id])
  brandId       String
  brand         Brand      @relation(fields: [brandId], references: [id])
  effectiveDate DateTime   @default(now())
  endDate       DateTime?
  status        String     @default("ACTIVE")

  @@unique([departmentId, brandId])
  @@map("department_assignments")
}

// Sales <-> Unit assignment history (BRD section 27)
model SalesAssignment {
  id            String    @id @default(uuid())
  salesId       String
  sales         User      @relation("AssignmentSales", fields: [salesId], references: [id])
  unitId        String
  unit          Unit      @relation(fields: [unitId], references: [id])
  effectiveDate DateTime
  endDate       DateTime?
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())

  @@map("sales_assignments")
}

model ActivityType {
  id              String                      @id @default(uuid())
  name            String                      @unique
  isActive        Boolean                     @default(true)
  events          Event[]
  expenses        Expense[]
  expenseRequests ExpenseRequest[]
  approvalLevels  ApprovalLevelActivityType[]
  createdAt       DateTime                    @default(now())

  @@map("activity_types")
}

model CostCenter {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  isActive  Boolean   @default(true)
  expenses  Expense[]
  createdAt DateTime  @default(now())

  @@map("cost_centers")
}

model PaymentMethod {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  isActive  Boolean   @default(true)
  expenses  Expense[]
  createdAt DateTime  @default(now())

  @@map("payment_methods")
}

model ExpenseCategory {
  id           String        @id @default(uuid())
  code         String        @unique
  name         String
  isActive     Boolean       @default(true)
  // Per-category spend ceiling for POLICY_EXCEPTION audit findings (see
  // AuditReportService). Null = no policy limit set, category is never flagged.
  policyLimit  Decimal?      @db.Decimal(18, 2)
  expenseItems ExpenseItem[]
  createdAt    DateTime      @default(now())

  @@map("expense_categories")
}

model Merchant {
  id             String    @id @default(uuid())
  name           String
  normalizedName String
  alias          String[]  @default([])
  isActive       Boolean   @default(true)
  invoices       Invoice[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([normalizedName])
  @@map("merchants")
}

// ---------------------------------------------------------------------------
// Event / Pre-Event (BRD section 7, 8)
// ---------------------------------------------------------------------------

enum EventStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  COMPLETED
}

model Event {
  id              String       @id @default(uuid())
  eventNo         String       @unique
  salesId         String
  sales           User         @relation("EventSales", fields: [salesId], references: [id])
  unitId          String
  unit            Unit         @relation(fields: [unitId], references: [id])
  departmentId    String?
  department      Department?  @relation(fields: [departmentId], references: [id])
  advertiserId    String
  advertiser      Advertiser   @relation(fields: [advertiserId], references: [id])
  brandId         String
  brand           Brand        @relation(fields: [brandId], references: [id])
  activityTypeId  String
  activityType    ActivityType @relation(fields: [activityTypeId], references: [id])
  date            DateTime
  startTime       String?
  endTime         String?
  location        String?
  purpose         String
  estimatedAmount Decimal      @db.Decimal(18, 2)
  notes           String?
  status          EventStatus  @default(DRAFT)
  rejectReason    String?

  participants    EventParticipant[]
  expenses        Expense[]
  approvalRequest ApprovalRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}

// Expense Request (Karangan Bunga), entered by Sales Admin. Flow:
//   DRAFT (editable by the requester; no approval chain yet) -> Submit ->
//   PENDING_APPROVAL (ApprovalLevel chain, DocumentStage.EXPENSE_REQUEST: Head Dept -> Co-CSO)
//   -> BUDGET_INPUT (Sales Customer Service, Position SLS_CS, fills budgetAmount)
//   -> CORSEC_VERIFICATION (Tim Corsec, Position CORSEC, picks Proceed / Cancel)
//   -> PROCEED (Corsec then uploads invoices and raises the Expense) | CANCELLED (Corsec, reason in rejectReason).
// REJECTED is an approver's reject during the Head Dept -> Co-CSO chain (also legacy Corsec "Rejected" rows).
// A reject/cancel at any stage is terminal. PROCEED was formerly APPROVED.
enum ExpenseRequestStatus {
  DRAFT
  PENDING_APPROVAL
  BUDGET_INPUT
  CORSEC_VERIFICATION
  PROCEED
  REJECTED
  CANCELLED
}

model ExpenseRequest {
  id               String                     @id @default(uuid())
  requestNo        String                     @unique
  requestedById    String
  requestedBy      User                       @relation("ExpenseRequestRequester", fields: [requestedById], references: [id])
  // Who keyed the Request in. Differs from requestedById (the requestor) when a holder of
  // webmobile.request.expense.create.owndept / Admin enters it on another user's behalf; that
  // inputter keeps edit/submit access to the DRAFT. Null when the requester entered it themselves.
  createdById      String?
  createdBy        User?                      @relation("ExpenseRequestCreatedBy", fields: [createdById], references: [id])
  // Drives the Department-scoped Head Dept step of the approval chain.
  departmentId     String?
  department       Department?                @relation(fields: [departmentId], references: [id])
  // Only "Karangan Bunga" is accepted for now (enforced in ExpenseRequestsService).
  activityTypeId   String
  activityType     ActivityType               @relation(fields: [activityTypeId], references: [id])
  // Legacy free-text client; new requests use agencies/advertisers/brands below.
  clientName       String?
  greetingText     String
  sendDate         DateTime
  recipientAddress String
  logo             String?
  // Budget the requester proposes at entry. Distinct from budgetAmount below
  // (the figure Sales Customer Service fills in later). Null on pre-existing rows.
  requestBudget    Decimal?                   @db.Decimal(18, 2)
  agencies         ExpenseRequestAgency[]
  advertisers      ExpenseRequestAdvertiser[]
  brands           ExpenseRequestBrand[]
  status           ExpenseRequestStatus       @default(PENDING_APPROVAL)
  rejectReason     String?

  // Filled by Sales Customer Service once the approval chain is done.
  budgetAmount Decimal?  @db.Decimal(18, 2)
  budgetNotes  String?
  budgetById   String?
  budgetBy     User?     @relation("ExpenseRequestBudgetBy", fields: [budgetById], references: [id])
  budgetAt     DateTime?

  // Corsec verification (Approved/Rejected flag).
  verifiedById String?
  verifiedBy   User?     @relation("ExpenseRequestVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  approvalRequest ApprovalRequest?
  // The Expense Corsec raised from this (APPROVED) Request, if any.
  expense         Expense?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("expense_requests")
}

// Agency (optional) / Advertiser / Brand picked on an Expense Request - each can hold several.
model ExpenseRequestAgency {
  id               String         @id @default(uuid())
  expenseRequestId String
  expenseRequest   ExpenseRequest @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)
  agencyId         String
  agency           Agency         @relation(fields: [agencyId], references: [id])
  createdAt        DateTime       @default(now())

  @@unique([expenseRequestId, agencyId])
  @@map("expense_request_agencies")
}

model ExpenseRequestAdvertiser {
  id               String         @id @default(uuid())
  expenseRequestId String
  expenseRequest   ExpenseRequest @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)
  advertiserId     String
  advertiser       Advertiser     @relation(fields: [advertiserId], references: [id])
  createdAt        DateTime       @default(now())

  @@unique([expenseRequestId, advertiserId])
  @@map("expense_request_advertisers")
}

model ExpenseRequestBrand {
  id               String         @id @default(uuid())
  expenseRequestId String
  expenseRequest   ExpenseRequest @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)
  brandId          String
  brand            Brand          @relation(fields: [brandId], references: [id])
  createdAt        DateTime       @default(now())

  @@unique([expenseRequestId, brandId])
  @@map("expense_request_brands")
}

model EventParticipant {
  id       String  @id @default(uuid())
  eventId  String
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name     String
  position String?
  company  String?

  @@map("event_participants")
}

// ---------------------------------------------------------------------------
// Expense / Invoice (BRD section 9, 15, 21, 28, 29, 43)
// ---------------------------------------------------------------------------

enum ExpenseStatus {
  DRAFT
  // Created by Corsec from an approved Expense Request (Expense.expenseRequestId):
  // waiting for a Sales Admin of the request's Department to complete the
  // details and submit it into the EXPENSES approval chain.
  PENDING_SALES_ADMIN
  PROCESSING
  OCR_COMPLETED
  MATCHING
  NEEDS_REVIEW
  READY_TO_SUBMIT
  SUBMITTED
  // Generic fallback - used only when the current approval step's Position has
  // no matching APPROVAL_<code> value below (e.g. a brand-new Position an Admin
  // just created and no migration has added a status for yet).
  PENDING_APPROVAL
  // One value per Position.code in today's master data (see prisma/seed.ts
  // positionDefs) - ApprovalsService.pendingStatusForPosition() derives these
  // from whatever Position sits at the Expense's current approval step, so the
  // status itself always names the tier currently reviewing it.
  APPROVAL_HEAD_POD
  APPROVAL_KOORDINATOR
  APPROVAL_SUPERVISOR
  APPROVAL_DEPT_HEAD
  APPROVAL_DIV_HEAD
  APPROVAL_BOD
  // Position codes carrying "-" (CO-CSO) are normalised to "_" before the
  // APPROVAL_<code> lookup - see ApprovalsService.pendingStatusForPosition.
  APPROVAL_CO_CSO
  // CO-CSO-1/CO-CSO-2 merged into the single CO-CSO tier above - kept only for
  // historical rows still carrying the old two-step chain.
  APPROVAL_CO_CSO_1
  APPROVAL_CO_CSO_2
  // DocumentStage.SETTLEMENT tier - the same Expense continues into this second
  // chain once a Settlement is created from it (SettlementsService), so its
  // status keeps naming whoever is reviewing it right now.
  APPROVAL_SLS_MAR_DIR
  APPROVAL_VP_ACC_BIL_TAX_3TV
  APPROVAL_CO_CFO_3TV
  // No longer produced by new code (final approval step now sets SETTLED
  // directly, no manual Finance settle) - kept for historical rows only.
  APPROVED
  REJECTED
  REVISION
  // Terminal of the DocumentStage.EXPENSES chain (HEAD_POD -> CO-CSO): approved,
  // now waiting for Sales Admin to bank-match it.
  READY_TO_MATCHING
  // Bank-matched - waiting to be grouped into a Settlement.
  READY_TO_SETTLED
  // Superseded by READY_TO_MATCHING/READY_TO_SETTLED - historical rows only.
  SETTLED
  // Terminal of the Settlement chain (SLS_MAR_DIR -> VP -> CO_CFO), set when
  // that Settlement's final tier is submitted - the batch is then pushed to the
  // external system (ExternalSyncService).
  COMPLETE
}

model Expense {
  id                     String          @id @default(uuid())
  expenseNo              String          @unique
  salesId                String
  sales                  User            @relation("ExpenseSales", fields: [salesId], references: [id])
  // Who keyed the Expense in. Differs from salesId (the requestor) when a
  // holder of expense.create.owndept/.all - e.g. a Sales Admin - enters it on
  // another user's behalf; that inputter keeps edit/upload/submit access to it.
  // Null on rows created before this column existed.
  createdById            String?
  createdBy              User?           @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  unitId                 String
  unit                   Unit            @relation(fields: [unitId], references: [id])
  departmentId           String?
  department             Department?     @relation(fields: [departmentId], references: [id])
  // Optional only for an Expense raised from an Expense Request that picked just an Agency;
  // every other creation path still requires both (ExpensesService.create).
  advertiserId           String?
  advertiser             Advertiser?     @relation(fields: [advertiserId], references: [id], onDelete: Restrict)
  brandId                String?
  brand                  Brand?          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  // Pre-Event used to be mandatory; an Expense can now also be created directly
  // (no approved Event) - see ExpensesService.create. When eventId IS given, it
  // must still be APPROVED and owned by the same Sales, and Advertiser/Brand/
  // Unit/ActivityType are inherited from it exactly as before.
  eventId                String?
  event                  Event?          @relation(fields: [eventId], references: [id])
  activityTypeId         String
  activityType           ActivityType    @relation(fields: [activityTypeId], references: [id])
  costCenterId           String?
  costCenter             CostCenter?     @relation(fields: [costCenterId], references: [id])
  paymentMethodId        String?
  paymentMethod          PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])
  // Free-text detail for the chosen payment method (e.g. AP voucher/reference
  // no, petty cash custodian). Unused for CORPORATE_CARD - creditCardId already
  // identifies the card.
  paymentMethodNote      String?
  creditCardId           String?
  creditCard             CreditCard?     @relation(fields: [creditCardId], references: [id])
  merchantName           String?
  // Free text - typically "lat, lng" filled from the browser's Geolocation API,
  // or a manually typed address/venue name.
  location               String?
  expenseDate            DateTime
  purpose                String
  amount                 Decimal         @db.Decimal(18, 2)
  status                 ExpenseStatus   @default(DRAFT)
  // Mirrors whether this Expense has a bank transaction currently AUTO_MATCHED
  // or MANUAL_MATCHED (see BankMatchingService.recomputeIsMatched) - kept as a
  // column rather than derived on every read so Settlement eligibility (only
  // isMatched Expenses can enter a Settlement) is a plain indexed filter.
  isMatched              Boolean         @default(false)
  settlementId           String?
  settlement             Settlement?     @relation(fields: [settlementId], references: [id])
  // Set when Corsec raised this Expense from an APPROVED Expense Request
  // (Karangan Bunga) - at most one Expense per Request. Such an Expense does NOT
  // skip the EXPENSES chain (see ApprovalsService.enterExpenseApproval).
  expenseRequestId       String?         @unique
  expenseRequest         ExpenseRequest? @relation(fields: [expenseRequestId], references: [id])
  // Highest Settlement-chain step (0-based) this Expense has been individually
  // approved at by that tier's approver. The Settlement's Submit is only allowed
  // once every member Expense has been reviewed at the current tier, i.e.
  // settlementApprovedStep >= approvalRequest.currentStep. Null = not yet
  // reviewed at any tier.
  settlementApprovedStep Int?

  items            ExpenseItem[]
  invoices         Invoice[]
  approvalRequest  ApprovalRequest?
  // Additional Brands beyond the single Brand inherited from the approved
  // Pre-Event (BR-002 keeps that one locked/mandatory) - lets Sales tag an
  // Expense as also covering other Brands entertained in the same activity.
  extraBrands      ExpenseBrand[]
  // Additional Agencies/Advertisers entertained in the same activity, same
  // add/remove pattern as extraBrands - auto pre-filled from the Pre-Event's
  // Advertiser/Agency on the client but freely editable before submit.
  extraAgencies    ExpenseAgency[]
  extraAdvertisers ExpenseAdvertiser[]
  // Agency/Advertiser/Employee attendees (name + jabatan), same shape as
  // EventParticipant but recorded per Expense rather than per Pre-Event.
  participants     ExpenseParticipant[]
  photos           ExpensePhoto[]
  bankTransactions BankTransaction[]
  auditFindings    AuditFinding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("expenses")
}

enum ParticipantCategory {
  AGENCY
  ADVERTISER
  EMPLOYEE
}

// agencyId/advertiserId/unitId: which already-selected Agency/Advertiser this
// participant belongs to (AGENCY/ADVERTISER category), or which Unit an
// internal/EMPLOYEE participant belongs to - all optional since only one is
// ever relevant depending on category, and older rows predate these columns.
model ExpenseParticipant {
  id           String              @id @default(uuid())
  expenseId    String
  expense      Expense             @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  category     ParticipantCategory
  name         String
  position     String?
  company      String?
  agencyId     String?
  agency       Agency?             @relation(fields: [agencyId], references: [id])
  advertiserId String?
  advertiser   Advertiser?         @relation(fields: [advertiserId], references: [id])
  unitId       String?
  unit         Unit?               @relation(fields: [unitId], references: [id])
  createdAt    DateTime            @default(now())

  @@map("expense_participants")
}

model ExpenseBrand {
  id        String   @id @default(uuid())
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id])
  createdAt DateTime @default(now())

  @@unique([expenseId, brandId])
  @@map("expense_brands")
}

model ExpenseAgency {
  id        String   @id @default(uuid())
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id])
  createdAt DateTime @default(now())

  @@unique([expenseId, agencyId])
  @@map("expense_agencies")
}

model ExpenseAdvertiser {
  id           String     @id @default(uuid())
  expenseId    String
  expense      Expense    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  advertiserId String
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([expenseId, advertiserId])
  @@map("expense_advertisers")
}

// Foto Kegiatan (activity photos) - separate from Invoice/InvoiceFile since
// these document the entertainment activity itself, not the merchant bill.
model ExpensePhoto {
  id         String   @id @default(uuid())
  expenseId  String
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  storageKey String
  fileName   String
  mimeType   String
  size       Int
  checksum   String
  createdAt  DateTime @default(now())

  @@map("expense_photos")
}

model ExpenseItem {
  id          String           @id @default(uuid())
  expenseId   String
  expense     Expense          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal          @db.Decimal(18, 2)
  categoryId  String?
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])

  @@map("expense_items")
}

enum MatchingStatus {
  UNMATCHED
  AUTO_MATCHED
  REVIEW_REQUIRED
  MANUAL_MATCHED
}

// Invoice: OCR/final split per BRD section 15 (Data Source Classification) and
// section 21 (Invoice Data Integrity). OCR/LLM pipeline itself is out of scope
// for Backend API Core - these ocr_* fields are populated manually or by a
// future worker via the same fields.
model Invoice {
  id            String    @id @default(uuid())
  expenseId     String
  expense       Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  invoiceNumber String?
  invoiceDate   DateTime?
  merchantId    String?
  merchant      Merchant? @relation(fields: [merchantId], references: [id])

  ocrMerchantName   String?
  finalMerchantName String?

  ocrSubtotal   Decimal? @db.Decimal(18, 2)
  finalSubtotal Decimal? @db.Decimal(18, 2)

  ocrTax   Decimal? @db.Decimal(18, 2)
  finalTax Decimal? @db.Decimal(18, 2)

  ocrServiceCharge   Decimal? @db.Decimal(18, 2)
  finalServiceCharge Decimal? @db.Decimal(18, 2)

  ocrDiscount   Decimal? @db.Decimal(18, 2)
  finalDiscount Decimal? @db.Decimal(18, 2)

  ocrTotal   Decimal? @db.Decimal(18, 2)
  finalTotal Decimal? @db.Decimal(18, 2)

  ocrConfidence  Decimal?       @db.Decimal(5, 2)
  matchingStatus MatchingStatus @default(UNMATCHED)

  modifiedById String?
  modifiedBy   User?     @relation("InvoiceModifiedBy", fields: [modifiedById], references: [id])
  modifiedAt   DateTime?

  files InvoiceFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

// BRD section 30 - object storage metadata only, no BLOB in Postgres
model InvoiceFile {
  id         String  @id @default(uuid())
  invoiceId  String
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fileType   String // ORIGINAL | PROCESSED
  storageKey String
  fileName   String
  mimeType   String
  size       Int
  checksum   String

  createdAt DateTime @default(now())

  @@map("invoice_files")
}

// ---------------------------------------------------------------------------
// Approval Workflow (BRD section 22, 23, 44 BR-013/BR-014)
// ---------------------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentStage {
  PRE_EVENT
  // Expense's own submit -> approval chain (BRD section 22-23) - despite the
  // enum name, ExpensesService.submit() is being switched to EXPENSES (see
  // migration 20260904_backfill below); SETTLEMENT is kept for a future
  // Settlement-entity-level approval flow, not currently wired to anything.
  EXPENSES
  SETTLEMENT
  // Expense Request (Karangan Bunga) chain: Head Dept -> Co-CSO. No amount at
  // submit time (budget is filled afterwards), so Levels use minAmount 0.
  EXPENSE_REQUEST
}

enum ApprovalScopeType {
  ANY
  DEPARTMENT
}

// scopeType DEPARTMENT can span more than one Department (e.g. one CO-CSO-1
// covering POD 1/4/5/6 under a single chain definition instead of duplicating
// the same steps across four near-identical Levels) - departments is the join
// table below. resolveApprover still resolves each step against the specific
// document's own departmentId (not "the Level's department", since there can
// be several), so DepartmentPositionAssignment stays one row per Department.
model ApprovalLevel {
  id                 String                           @id @default(uuid())
  name               String
  documentStage      DocumentStage
  scopeType          ApprovalScopeType                @default(ANY)
  departments        ApprovalLevelDepartment[]
  // Which Position(s) the requestor (Expense.sales / Event.sales) must hold for
  // this Level to match - independent of scopeType/departments, which govern how
  // the chain's own approvers resolve. Empty = matches any requestor (default,
  // backward compatible). Lets e.g. a Sales requestor get HEAD_POD -> CO-CSO-1
  // while a HEAD_POD requestor (submitting their own Expense) gets a different,
  // higher chain such as CO-CSO-1 -> CO-CSO-2 directly.
  requestorPositions ApprovalLevelRequestorPosition[]
  // Optional ActivityType filter(s), independent of scopeType/departments: when
  // non-empty the Level only matches documents whose Activity Type is among these
  // (empty = any, backward compatible). e.g. Expense Request "Karangan Bunga":
  // POD/Sales Department -> Head Dept -> Co-CSO, HRD -> Div Head. For an Expense,
  // an EXPENSE_REQUEST Level scoped this way also means "already approved up
  // front" - see ApprovalsService.enterExpenseApproval.
  activityTypes      ApprovalLevelActivityType[]
  minAmount          Decimal                          @default(0) @db.Decimal(18, 2)
  maxAmount          Decimal?                         @db.Decimal(18, 2)
  isActive           Boolean                          @default(true)
  steps              ApprovalLevelStep[]
  requests           ApprovalRequest[]
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt

  @@map("approval_levels")
}

// Which Department(s) an ApprovalLevel (scopeType DEPARTMENT) applies to - a
// Level matches a document when the document's own departmentId is among these.
model ApprovalLevelDepartment {
  id              String        @id @default(uuid())
  approvalLevelId String
  approvalLevel   ApprovalLevel @relation(fields: [approvalLevelId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([approvalLevelId, departmentId])
  @@map("approval_level_departments")
}

// Which Activity Type(s) an ApprovalLevel applies to - see ApprovalLevel.activityTypes comment.
model ApprovalLevelActivityType {
  id              String        @id @default(uuid())
  approvalLevelId String
  approvalLevel   ApprovalLevel @relation(fields: [approvalLevelId], references: [id], onDelete: Cascade)
  activityTypeId  String
  activityType    ActivityType  @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())

  @@unique([approvalLevelId, activityTypeId])
  @@map("approval_level_activity_types")
}

// Which Position(s) the requestor must hold for an ApprovalLevel to match - see
// ApprovalLevel.requestorPositions comment.
model ApprovalLevelRequestorPosition {
  id              String        @id @default(uuid())
  approvalLevelId String
  approvalLevel   ApprovalLevel @relation(fields: [approvalLevelId], references: [id], onDelete: Cascade)
  positionId      String
  position        Position      @relation(fields: [positionId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([approvalLevelId, positionId])
  @@map("approval_level_requestor_positions")
}

model ApprovalLevelStep {
  id              String        @id @default(uuid())
  approvalLevelId String
  approvalLevel   ApprovalLevel @relation(fields: [approvalLevelId], references: [id], onDelete: Cascade)
  stepOrder       Int
  positionId      String
  position        Position      @relation(fields: [positionId], references: [id])

  @@unique([approvalLevelId, stepOrder])
  @@map("approval_level_steps")
}

model ApprovalRequest {
  id               String                @id @default(uuid())
  documentStage    DocumentStage
  expenseId        String?               @unique
  expense          Expense?              @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  eventId          String?               @unique
  event            Event?                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  expenseRequestId String?               @unique
  expenseRequest   ExpenseRequest?       @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)
  // DocumentStage.SETTLEMENT - the batch's own chain (SLS_MAR_DIR -> VP ->
  // CO_CFO). A tier advances only when its approver presses Submit on the
  // Settlement, after reviewing each member Expense individually
  // (Expense.settlementApprovedStep).
  settlementId     String?               @unique
  settlement       Settlement?           @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  approvalLevelId  String
  approvalLevel    ApprovalLevel         @relation(fields: [approvalLevelId], references: [id])
  currentStep      Int                   @default(0)
  status           ApprovalStatus        @default(PENDING)
  steps            ApprovalRequestStep[]
  actions          ApprovalAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("approval_requests")
}

model ApprovalRequestStep {
  id                 String             @id @default(uuid())
  approvalRequestId  String
  approvalRequest    ApprovalRequest    @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  stepOrder          Int
  positionId         String
  position           Position           @relation(fields: [positionId], references: [id])
  resolvedApproverId String
  resolvedApprover   User               @relation("ApprovalStepApprover", fields: [resolvedApproverId], references: [id])
  status             ApprovalStepStatus @default(PENDING)
  // Settlement chain only: when the approver pressed "Submit" for this tier
  // (submitSettlementTier) and who did (the assigned approver, or an Admin acting
  // for them). Both cleared again if the tier is reopened by a revise.
  submittedAt        DateTime?
  submittedById      String?
  submittedBy        User?              @relation("ApprovalStepSubmitter", fields: [submittedById], references: [id])

  // One-click email approval (BRD-adjacent feature): a single-use token mailed
  // to resolvedApprover while this step is the request's current step. Cleared
  // (set back to null) once used, so it can't be replayed.
  emailToken          String?   @unique
  emailTokenExpiresAt DateTime?

  @@unique([approvalRequestId, stepOrder])
  @@map("approval_request_steps")
}

enum ApprovalActionType {
  APPROVE
  REJECT
  // Sends the request back exactly one tier (currentStep - 1) instead of
  // terminating it - earlier APPROVED steps are left untouched. See
  // ApprovalsService.revise / reviseSettlementTier.
  REVISE
}

model ApprovalAction {
  id                String             @id @default(uuid())
  approvalRequestId String
  approvalRequest   ApprovalRequest    @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  actorId           String
  actor             User               @relation("ApprovalActor", fields: [actorId], references: [id])
  positionId        String
  position          Position           @relation(fields: [positionId], references: [id])
  action            ApprovalActionType
  reason            String?
  actedAt           DateTime           @default(now())

  @@map("approval_actions")
}

// ---------------------------------------------------------------------------
// Auto Matching - Bank Settlement (reconcile Expense against a bank
// settlement/credit-card statement PDF uploaded by Finance)
// ---------------------------------------------------------------------------

enum BankTxnStatus {
  UNMATCHED
  AUTO_MATCHED
  REVIEW_REQUIRED
  MANUAL_MATCHED
}

model BankSettlementBatch {
  id           String            @id @default(uuid())
  fileName     String
  storageKey   String
  // SHA-256 of the file content. Lets uploadAndMatch() detect "this exact file was
  // already scanned" and short-circuit to the existing batch instead of reparsing
  // (nullable+unique so legacy rows without a hash don't collide).
  contentHash  String?           @unique
  uploadedById String
  uploadedBy   User              @relation("BatchUploadedBy", fields: [uploadedById], references: [id])
  // Which Department/Corporate Card this statement file is for - informational
  // (matches the Department picked in the Auto Match popup, not derived from
  // the PDF itself), and also scopes matching: uploadAndMatch()/rematch() only
  // score this batch's lines against Expenses in departmentId, since the same
  // amount/date can legitimately appear on two different cards in one dept.
  departmentId String?
  department   Department?       @relation(fields: [departmentId], references: [id])
  creditCardId String?
  creditCard   CreditCard?       @relation(fields: [creditCardId], references: [id])
  transactions BankTransaction[]
  createdAt    DateTime          @default(now())

  @@map("bank_settlement_batches")
}

model BankTransaction {
  id               String              @id @default(uuid())
  batchId          String
  batch            BankSettlementBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  lineNo           Int
  transactionDate  DateTime?
  rawDescription   String
  amount           Decimal             @db.Decimal(18, 2)
  cardLast4        String?
  status           BankTxnStatus       @default(UNMATCHED)
  matchedExpenseId String?
  matchedExpense   Expense?            @relation(fields: [matchedExpenseId], references: [id])
  matchScore       Decimal?            @db.Decimal(5, 2)
  matchedById      String?
  matchedBy        User?               @relation("BankTxnMatchedBy", fields: [matchedById], references: [id])
  matchedAt        DateTime?
  createdAt        DateTime            @default(now())

  @@map("bank_transactions")
}

// Groups a Department's already-matched (bank-reconciled) Expenses into one
// settlement batch - one Settlement per Department per "Create Settlement"
// click (a Sales/Admin covering several Departments gets one Settlement per
// Department with eligible Expenses).
// settlementNo format: STL-YYMMDD#### (see SettlementsService.generateSettlementNo).
model Settlement {
  id               String                 @id @default(uuid())
  settlementNo     String                 @unique
  departmentId     String
  department       Department             @relation(fields: [departmentId], references: [id])
  totalAmount      Decimal                @db.Decimal(18, 2)
  status           SettlementStatus       @default(DRAFT)
  createdById      String
  createdBy        User                   @relation("SettlementCreatedBy", fields: [createdById], references: [id])
  expenses         Expense[]
  approvalRequest  ApprovalRequest?
  allocations      SettlementAllocation[]
  // Sync state to the external (Odoo) system - only meaningful once status
  // reaches COMPLETE. PENDING is set right before ExternalSyncService.pushSettlement
  // attempts the push; it resolves to SENT or FAILED synchronously in the same
  // call, so rows don't rest at PENDING in normal operation. FAILED is retryable
  // via SettlementsService.retrySync - the guard that keeps a SENT Settlement
  // from ever being pushed twice is odooSyncStatus === SENT (not a null check).
  odooSyncStatus   OdooSyncStatus         @default(NOT_STARTED)
  odooSyncError    String?
  odooSyncAttempts Int                    @default(0)
  sentAt           DateTime?
  auditFindings    AuditFinding[]
  createdAt        DateTime               @default(now())

  @@map("settlements")
}

enum OdooSyncStatus {
  NOT_STARTED // Settlement hasn't reached COMPLETE yet - sync not attempted
  PENDING // push attempted, awaiting the (synchronous) HTTP result
  SENT
  FAILED
}

enum SettlementStatus {
  DRAFT
  // Set when the Settlement is first created (create()/createFromSelection()) -
  // the allocation rows entered in the Create Settlement popup are saved here,
  // but the approval chain has not started yet. Only advances to
  // APPROVAL_SLS_MAR_DIR once the user presses the settlement list's own
  // "Submit" action (SettlementsService.submitDraft).
  DRAFT_SETTLEMENT
  // Mirrors whichever tier of the Settlement's own approval chain is reviewing
  // the batch right now - the member Expenses carry the matching
  // ExpenseStatus.APPROVAL_* value, and both advance together when that tier's
  // approver presses Submit (SettlementsService.submitCurrentTier).
  APPROVAL_SLS_MAR_DIR
  APPROVAL_VP_ACC_BIL_TAX_3TV
  APPROVAL_CO_CFO_3TV
  // Set by ApprovalsService.reviseSettlementTier - the current tier's approver
  // sent the whole batch back one tier instead of submitting/rejecting it.
  // Member Expenses move to ExpenseStatus.REVISION and have
  // settlementApprovedStep cleared so the resumed tier must re-review each one
  // (SettlementsService.update resumes the chain via
  // ApprovalsService.resumeSettlementApproval once edited).
  REVISION
  COMPLETE
  REJECTED
}

// One revenue-split / ERP journal line entered in the Create Settlement popup
// (BRD: Unit + Persentase + Analytic Acc/Account/Wilayah/Line PR/... columns
// below the picked Expenses, added dynamically row by row). Original Price,
// Unit Price and Total Price are always server-computed as
// (sum of the Settlement's Expense amounts) * percentage / 100 - never trusted
// from the client - see SettlementsService.buildAllocationRow.
model SettlementAllocation {
  id            String     @id @default(uuid())
  settlementId  String
  settlement    Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  unitId        String
  unit          Unit       @relation(fields: [unitId], references: [id])
  percentage    Decimal    @db.Decimal(5, 2)
  description   String?
  analyticAcc   String?
  account       String?
  wilayah       String?
  linePr        String?
  qty           Decimal    @default(1) @db.Decimal(18, 2)
  curr          String     @default("IDR")
  originalPrice Decimal    @db.Decimal(18, 2)
  rate          Decimal    @default(1) @db.Decimal(18, 4)
  unitPrice     Decimal    @db.Decimal(18, 2)
  totalPrice    Decimal    @db.Decimal(18, 2)
  createdAt     DateTime   @default(now())

  @@map("settlement_allocations")
}

// ---------------------------------------------------------------------------
// Audit Trail (BRD section 24)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  objectType String
  objectId   String?
  oldValue   Json?
  newValue   Json?
  timestamp  DateTime @default(now())
  ipAddress  String?
  device     String?

  @@index([objectType, objectId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Approval-activity notifications (in-app + push) - fired from the same
// notifyStep hook that sends approval emails (src/approvals/approvals.service.ts),
// covering both the Expense/Event chain and the Settlement chain. Deliberately
// minimal (no read-receipt history, no per-type table) - this is a fan-out
// record + a device registry, not a message queue.
// ---------------------------------------------------------------------------

model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String
  // Frontend/mobile route target, e.g. "/settlement/<id}" or "/expenses/<id>" -
  // resolved client-side (web query param, mobile deep-link parse), not a
  // server-rendered link.
  deepLink   String?
  objectType String
  objectId   String
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId, read])
  @@map("notifications")
}

enum NotificationType {
  EXPENSE_PENDING
  EVENT_PENDING
  SETTLEMENT_PENDING
  EXPENSE_REJECTED
  EVENT_REJECTED
  SETTLEMENT_REJECTED
  SETTLEMENT_COMPLETE
  EXPENSE_REQUEST_PENDING
  EXPENSE_REQUEST_REJECTED
  EXPENSE_REVISED
  SETTLEMENT_REVISED
}

// One row per installed app instance (not per user - a user can have several
// devices). Pruned when Firebase reports the token as no-longer-registered.
model DeviceToken {
  id         String              @id @default(uuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String              @unique
  platform   DeviceTokenPlatform
  createdAt  DateTime            @default(now())
  lastSeenAt DateTime            @default(now())

  @@index([userId])
  @@map("device_tokens")
}

enum DeviceTokenPlatform {
  ANDROID
  IOS
}

// ---------------------------------------------------------------------------
// Audit Report Dashboard - compliance findings derived from Expense/Invoice/
// Settlement data (not to be confused with AuditLog above, which is a raw
// mutation-event log). Rows are upserted by AuditReportService.ensureFindingsSynced()
// on every dashboard read, keyed by (findingType, expenseId|settlementId), so
// amount/riskLevel/agingDays always reflect current source data while status/
// notes/resolvedAt (the human audit workflow) persist across syncs.
// ---------------------------------------------------------------------------

enum AuditFindingType {
  MISSING_RECEIPT
  UNMATCHED_TRANSACTION
  OVERDUE_SETTLEMENT
  DUPLICATE_CLAIM
  POLICY_EXCEPTION
}

enum AuditRiskLevel {
  HIGH
  MEDIUM
  LOW
}

enum AuditFindingStatus {
  OPEN
  FOLLOW_UP
  INVESTIGATING
  RESOLVED
}

model AuditFinding {
  id          String             @id @default(uuid())
  // Drives the human-facing findingNo (AUD-{year}-{seq padded to 4}), computed
  // in AuditReportService rather than stored, since the year comes from createdAt.
  seq         Int                @default(autoincrement())
  findingType AuditFindingType
  riskLevel   AuditRiskLevel
  status      AuditFindingStatus @default(OPEN)
  amount      Decimal            @db.Decimal(18, 2)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  expenseId    String?
  expense      Expense?    @relation(fields: [expenseId], references: [id])
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])

  // Snapshot at last sync - days since expenseDate (expense-based types) or
  // since createdAt (OVERDUE_SETTLEMENT).
  agingDays  Int
  detectedAt DateTime @default(now())

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("AuditFindingResolvedBy", fields: [resolvedById], references: [id])
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([findingType, expenseId])
  @@unique([findingType, settlementId])
  @@index([riskLevel])
  @@index([status])
  @@index([departmentId])
  @@map("audit_findings")
}
